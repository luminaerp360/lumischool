# ── LumiSchool Environment Variables ──

# App
NODE_ENV=development
PORT=3400
APP_NAME=LumiSchool
FRONTEND_URL=http://localhost:4200

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lumischool?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# MPESA Daraja API
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENV=sandbox

# Africa's Talking SMS
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_USERNAME=sandbox

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=lumischool-uploads
AWS_REGION=af-south-1

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# SMTP (alternative to SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
